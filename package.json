{
    "name": "TenT_FS",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "build": "turbo run build --force",
        "generate": "turbo run generate",
        "dev": "turbo run dev",
        "dev:backend": "turbo run dev --filter=backend",
        "db:generate": "turbo run db:generate --filter=@repo/db",
        "env:cp": "cp .env ./apps/backend/.env && cp .env ./apps/web/.env && cp .env ./packages/db/.env",
        "lint": "turbo run lint",
        "format": "prettier --write \"apps/**/*.{json,js,ts,tsx,md}\" \"packages/**/*.{json,js,ts,tsx,md}\"",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "prettier": "^3.7.4",
        "prisma": "^7.8.0",
        "turbo": "^2.9.15",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "packageManager": "yarn@4.15.0+sha512.07ec708ac11e2eaa4ea2b04cfbb272812f7e74a753f1595eaef4486c663a98306a30cca3e6fc40f7a0b168dcfb3a2490b6a5e0501e20fb69cc36f563dd161c53"
}
